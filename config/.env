# ===================================================================
# dronelm — configuración unificada del proyecto (fuente única)
# ===================================================================
# Este es EL ÚNICO archivo de configuración de todo el repositorio.
# Todos los subproyectos lo leen con una ruta explícita:
#
#   airsim-loop/   → Path(__file__).parents[1|2|3] / "config" / ".env"
#   airsim-plan/   → Path(__file__).parents[3]     / "config" / ".env"
#   airsim-poc/    → Path(__file__).parents[1]     / "config" / ".env"
#   airsim-mcp/    → Path(__file__).parents[1]     / "config" / ".env"
#   airsim-kc/     → Path(__file__).parents[1]     / "config" / ".env"
#   airsim-cmd/    → Path(__file__).parents[1]     / "config" / ".env"
#   callibration_flight/ → Path(__file__).parents[1] / "config" / ".env"
#   local-llm-eval/      → Path(__file__).parents[1] / "config" / ".env"
#
# Para agregar un nuevo subproyecto: añadir load_dotenv con la
# profundidad correcta (N = niveles hasta la raíz del repo).
# ===================================================================


# ─── HARDWARE: AirSim ───────────────────────────────────────────────────────
# IP de la máquina que corre Unreal Engine / AirSim.
# 2026-0824: migrado a loopback. airsim-loop corre EN la misma máquina que
# UE/AirSim (Windows); la latencia RPC sobre LAN era >8s independiente de la
# resolución (timeout sistemático en simGetImages sobre 192.168.110.110).
# Mover de vuelta a red: cambiar a 192.168.110.110 y remedir con
# scripts/bench_capture.py antes de confiar en LOOP_HZ=5.
AIRSIM_IP="127.0.0.1"
# AIRSIM_HOST es el alias que usa airsim-plan/config.py — mismo valor.
AIRSIM_HOST="127.0.0.1"
AIRSIM_PORT=41451
# Debe coincidir EXACTO con el vehiculo de airsim-settings/settings.json (`Vehicles.<nombre>`).
# 2026-0929: settings.json paso a definir `Drone1` (necesario para colgarle la FollowCam); con
# "SimpleFlight" (el nombre por defecto de AirSim sin bloque Vehicles) el plugin recibe un
# vehiculo inexistente y Unreal se cae con EXCEPTION_ACCESS_VIOLATION. AirSimClient.connect()
# ahora lo verifica con listVehicles() y falla con un mensaje claro.
AIRSIM_VEHICLE_NAME="Drone1"
AIRSIM_CAMERA_NAME="0"
DEFAULT_FRAME_WIDTH=1080
DEFAULT_FRAME_HEIGHT=720
# Timeout (s) por llamada RPC individual. Con AirSim en localhost <100ms
# en régimen; si sigue timeando en 127.0.0.1 es GPU saturada, no red.
AIRSIM_RPC_TIMEOUT=8
# false solo en tests: permite frames sintéticos si AirSim no responde.
AIRSIM_STRICT=true


# ─── SERVIDOR LLM (Ollama local) ─────────────────────────────────────────────
# 2026-10-07: Ollama local (127.0.0.1:11434 (no localhost: resuelve a ::1 primero y demora ~2 s), endpoint OpenAI-compatible en /v1).
# Antes: LM Studio en Mac 192.168.110.101:1234. La latencia de red está absorbida por
# diseño: DeliberationService llama al VLM en hilo separado → el brazo `slm`
# nunca bloquea el loop de control (ver src/agents/deliberation_service.py).
#
# LOCAL_LLM_* : usado por airsim-loop (deliberative.py, deep_scan.py, spatial_scan.py)
# Modelo de vuelo: LFM2.5-VL-1.6B Q4_K_M GGUF (Ollama; NO la variante -Extract, que rellena el JSON sin mirar la imagen). No usar la version MLX (mlx-community/...): devuelve
# texto vacio cuando la consulta pide JSON forzado y logprobs a la vez.
LOCAL_LLM_URL="http://127.0.0.1:11434/v1"
# Tag local creado con num_ctx=8192 (base hf.co/LiquidAI/LFM2.5-VL-1.6B-GGUF:Q4_K_M, que carga 128k
# de contexto y ocupa 3.1 GB de VRAM; con 8k ~1.0 GB). Peor consulta medida: 4 imagenes 384px ~815 tokens.
LOCAL_LLM_API_KEY="OLLAMA_MOCK_KEY"
LOCAL_LLM_MODEL_NAME="lfm2.5-vl-1.6b:q4km-ctx8k"
#
# OLLAMA_* / TACTICAL_* : aliases usados por airsim-plan/config.py.
# Apuntan al mismo servidor; separados para poder usar modelos distintos
# en el planificador de misión (táctico) vs. el árbitro de evasión (VLM).
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_API_KEY="OLLAMA_MOCK_KEY"
OLLAMA_MODEL="lfm2.5-vl-1.6b:q4km-ctx8k"
TACTICAL_BASE_URL="http://127.0.0.1:11434/v1"
TACTICAL_API_KEY="OLLAMA_MOCK_KEY"
TACTICAL_MODEL="lfm2.5-vl-1.6b:q4km-ctx8k"
#
# OLLAMA_HOST : alias sin /v1, usado por local-llm-eval/check_ollama.py.
OLLAMA_HOST="http://127.0.0.1:11434"


# ─── DELIBERACIÓN / VLM ──────────────────────────────────────────────────────
# Ancho máximo (px) del frame enviado al VLM. Independiente de FLOW_DOWNSCALE_WIDTH
# (que sólo afecta el cálculo de flujo óptico, no lo que ve el modelo).
VLM_IMAGE_MAX_SIZE=384
# Tamaño de imagen para el scan panoramico (4 imagenes simultaneas).
# Menor que VLM_IMAGE_MAX_SIZE: 256px ahorra ~500 vision tokens y ~1s de prefill.
DEEP_SCAN_IMAGE_MAX_SIZE=256
# Cuántos frames consecutivos se incluyen en cada prompt de visión.
VLM_FRAME_HISTORY_SIZE=1
# Usar JSON schema en la respuesta del VLM para obtener structured output.
VLM_USE_JSON_SCHEMA=true
# Rutas a los archivos de system prompt (relativas al directorio donde se lanza
# el runner, típicamente airsim-loop/). Permiten editar los prompts sin tocar
# el código Python. Si no se configuran, se usa el prompt interno como fallback.
# Los archivos admiten placeholders {safe_margin_ttc_s} que se sustituyen al cargar.
SYSTEM_PROMPT_VISION_FILE=../config/prompts/system_vision.txt
SYSTEM_PROMPT_TEXT_FILE=../config/prompts/system_text.txt
# Watchdog del brazo deliberativo: ms máximos esperando respuesta del VLM
# antes de caer al fallback reactivo. Re-calibrado 2026-09-22: con imagen
# base64 qwen2.5-vl-3b tarda ~10-11s → watchdog debe ser > latencia máxima
# medida. Debe ser MENOR que SLM_HTTP_TIMEOUT_S (15s) para que el watchdog
# dispare antes de que el cliente HTTP corte la conexión.
SLM_WATCHDOG_MS=13000
# Timeout del cliente HTTP para llamadas tácticas al VLM (1 imagen).
# Debe ser > SLM_WATCHDOG_MS para que el watchdog siempre gane al corte HTTP.
SLM_HTTP_TIMEOUT_S=15.0
# Timeout del cliente HTTP para escaneo profundo (deep_vlm, múltiples imágenes).
# Mayor que SLM_HTTP_TIMEOUT_S por el prefill extra de imágenes adicionales.
SLM_DEEP_HTTP_TIMEOUT_S=20.0
# Watchdog del escaneo profundo (deep_vlm panoramico). Debe ser < SLM_DEEP_HTTP_TIMEOUT_S.
# Corrida 125339Z: qwen2.5-vl-3b tarda 12.1-12.3s en el scan panoramico de 4 imagenes;
# el default 12000ms provoco 4/12 timeouts. Subido a 18000ms para dar margen.
SLM_DEEP_WATCHDOG_MS=18000
# Estrategia de desbloqueo en atasco duro (deadlock), 2026-0930:
# deep_vlm (default): barrido panoramico de 4 rumbos + una consulta al VLM -> sub-meta en marco mundo.
# blind:              sin VLM, escape vertical determinista (ablacion).
# slam_assess se movio a src/agents/legacy/deep_scan_v2.py (5 corridas, todas truncadas, sin control).
DEADLOCK_STRATEGY=deep_vlm


# ─── LAZO DE CONTROL ─────────────────────────────────────────────────────────
# Frecuencia (Hz) del loop de control. Con AirSim en localhost medir con
# airsim-loop/scripts/bench_capture.py antes de subir de 5 Hz.
LOOP_HZ=5.0
# Brazo de política activo: slm | fsm | reactive.
# Sobreescrito por runner.py y batch_runner.py durante corridas batch.
AGENT_ARM=slm


# ─── GRABACIÓN Y LOGGING ─────────────────────────────────────────────────────
# Directorio raíz donde cada corrida crea su carpeta <MISSION_ID>-<ISO>/.
# Si es relativo, se ancla a la raíz del repo (no al CWD del script).
# El directorio físico es dronelm/airsim-runs/ — todos los subproyectos
# escriben ahí. Ignorado por git (ver .gitignore).
AIRSIM_RUNS_DIR="airsim-runs"
# Grabar video anotado por corrida (src/logging/flight_video.py). Opt-in;
# poner false para corridas batch/headless donde el video no se necesita
# (ahorra ~30% de ciclos de CPU). runner.py puede sobreescribir vía env.
FLIGHT_RECORD_VIDEO=true

# Grabar el viewport de Unreal Engine lado a lado con la cámara del drone.
# Requiere: pip install mss pywin32 (solo en Windows).
# Cuando está activo el video sale con doble ancho: [drone cam | viewport UE].
# Si mss/pywin32 no están instalados, o la ventana no está visible, el panel
# derecho sale en negro y el video sigue grabándose sin error (degradación
# silenciosa). Dejar false en corridas batch o headless (sin UE en pantalla).
# Default: false
FLIGHT_RECORD_VIEWPORT=false

# Video de la camara externa "FollowCam" (definida en airsim-settings/settings.json), un
# .follow.webm por corrida sincronizado con el frontal y mostrado en el viewer.html.
# Se pide en la misma llamada simGetImages del ciclo; SOLO auditoria: nunca entra al
# DroneState ni a la percepcion/VLM. Vacio o "none" desactiva; solo aplica si
# FLIGHT_RECORD_VIDEO=true. Si la camara no existe en la simulacion se desactiva sola.
AIRSIM_FOLLOW_CAMERA=FollowCam

# Substring del título de la ventana de Unreal Engine que busca ViewportCapture.
# Se compara ignorando mayúsculas; la primera ventana visible que lo contenga
# y tenga tamaño > 100×100 px es la que se captura.
# UE5 típicamente se llama "UnrealEditor - <NombreProyecto>".
# Default: UnrealEditor
VIEWPORT_WINDOW_TITLE="UnrealEditor"

# Región fija de pantalla a capturar en lugar de buscar la ventana por título.
# Formato: left,top,right,bottom  (coordenadas absolutas de pantalla en píxeles).
# Útil si la detección automática de ventana falla o se quiere capturar solo
# el viewport interior (sin el chrome del editor).
# Ejemplo (monitor 1920×1080, viewport en la mitad derecha):
#   VIEWPORT_REGION=960,0,1920,1080
# Si está vacío, se usa VIEWPORT_WINDOW_TITLE para encontrar la ventana.
# Default: (vacío — detección automática por título)
# VIEWPORT_REGION=


# ─── NAVEGACIÓN / GUIADO ─────────────────────────────────────────────────────
# Velocidad de crucero (m/s) del brazo reactivo y referencia de guía.
# Subido 2.0 → 3.0 en 2026-0826: TTC_SAFE/EVASION son umbrales de TIEMPO,
# no de distancia; el margen de reacción no se degrada al subir la velocidad.
# No subir sin remedir en CityParkSim (obstáculos reales) antes de confiar.
REACTIVE_FORWARD_SPEED=3.0
# Topes de yaw_rate del guiado (°/s). El sharp es para desvíos >60°; permite
# realinear un desvío grande sin que el contador de atasco se dispare primero.
GUIDANCE_YAW_RATE_MAX_DPS=15.0
GUIDANCE_YAW_RATE_SHARP_MAX_DPS=45.0
# Umbral de distancia horizontal (m) al WP por debajo del cual compute_guidance()
# considera el rumbo objetivo inestable (WP casi vertical: mismo XY, distinto Z).
# 2026-0910: subido 1.0 → 4.0 para cubrir desplazamientos XY causados por
# maniobras EVADIR durante el ascenso a WP_0 (observado: 3.18m de deriva →
# el tracker calculaba bearing ~167° y activaba _sharp_turn_active = 149° de giro).
BEARING_UNSTABLE_DIST_XY_M=4.0
# Velocidad mínima (m/s) de acercamiento a un WP para no acumular atasco.
# Con WAYPOINT_PROGRESS_EPS_M=0.5 (hardcoded) y LOOP_HZ=5 el umbral efectivo
# resulta ceil(0.5*5/0.25)=10 ciclos. Ver waypoint_tracker.py:effective_stall_threshold().
MIN_PROGRESS_SPEED_MPS=0.25
# Multiplicador del umbral de atasco: si el contador llega a
# EVASION_STUCK_THRESHOLD * STUCK_HARD_FACTOR el escape se fuerza aunque
# la percepción crea ver un corredor libre (techo del bypass por percepción).
# Reducido 3.0→1.5: hard_stall pasa de 30 a 15 ciclos (3s a 5Hz).
# Con 3.0 el drone llegaba a embeberse en la malla del árbol antes de que
# slam_assess se activara (datos seed_1.jsonl: 254 ciclos entre deadlock y
# RETROCEDER). 1.5 mantiene margen suficiente sobre effective_stall_threshold.
STUCK_HARD_FACTOR=1.5
# Ciclos consecutivos sin progreso antes de disparar escape por altura.
# Derivado de MIN_PROGRESS_SPEED_MPS arriba; puede sobreescribirse aquí si
# se quiere un umbral fijo independiente de la fórmula dinámica.
EVASION_STUCK_THRESHOLD=10


# ─── PLAN-SLAM: mitigaciones de percepción monocular (P1–P3) ─────────────────
# P2: holdover — cuántos frames se sostiene el último TTC válido cuando
# foe_confidence=0 (giro activo, textura baja). Default=3 → 0.6s a 5Hz.
FLOW_HOLDOVER_MAX_FRAMES=3
# P3: tope de yaw_rate (°/s) cuando el dron está cerca de un obstáculo
# (TTC_centro < TTC_BLOCKED_THRESHOLD_S). Mantiene derotación dentro del
# límite operativo de FlowTTCEstimator (~0.175 rad/s ≈ 10°/s).
FLOW_MAX_YAW_DPS_NEAR_OBSTACLE=5.0


# ─── Maniobras ───────────────────────────────────────────────────────────────
# SLAM_STALL_THRESHOLD_M solo lo usa experiments/s5_offline_validation.py (analisis offline legacy).
SLAM_STALL_THRESHOLD_M=0.3
# Duracion (s) de las maniobras de evasion comprometidas (EVADIR_*, y la macro del barrido).
MANEUVER_DURATION_S=2.0
# S3b (YOLO semántico en stalls): desactivado por defecto.
# SLAM_YOLO_ENABLED=false
# SLAM_YOLO_MODEL=yolov8n.pt
# SLAM_YOLO_MIN_CONF=0.45
# S2b (SfM por sectores): desactivado por defecto.
# SLAM_SFM_ENABLED=false
# Distancia (m) del corner waypoint inyectado tras RETROCEDER (action_map.py).
# El corner se coloca a esta distancia en la dirección lateral (90°) desde la
# posición actual. Debe ser mayor que la extensión lateral del cluster de
# obstáculos para que el drone pueda rodear el bloqueo sin re-embeberse.
# 12m es el default de action_map.py; 15m para clusters de palmeras anchos.
# 2026-0929: bajado de 30 a 15. Con 30 m un solo escaneo llevaba al dron a otro
# cuadrante del mapa (citysim_pilot seed 99 00:42: esquina a 30 m en sentido
# contrario al WP, 15 esquinas en cola, 138 m de WP_1 al final). Ver CHANGELOG.
CORNER_OFFSET_M=15.0

# ─── FRENTE BLOQUEADO / SEGURIDAD DE APROXIMACION (2026-0929) ────────────────
# Motivo: incrustado en una fachada (citysim_pilot seed 99 02:32). Ver CHANGELOG (j).
# Gobernador de velocidad (src/navigation/speed_governor.py): topa MANTENER_RUMBO sin evidencia de flujo,
# tras un frente bloqueado y en la rampa posterior a una maniobra. GOV_ENABLED=false lo desactiva.
GOV_ENABLED=true
GOV_SLOW_MPS=1.0
GOV_MID_MPS=1.5
GOV_DEGRADED_MID_CYCLES=3
GOV_DEGRADED_SLOW_CYCLES=8
GOV_BLOCK_MEMORY_CYCLES=40
GOV_RAMP_CYCLES=15
# Vigilante de congelamiento fisico (dron incrustado en la malla): N ciclos con estado identico.
# FREEZE_RECOVERY: abort (default, integridad del experimento) | teleport (vuelve a la ultima pose libre,
# max FREEZE_MAX_RECOVERIES veces; queda como evento freeze_recovery y freeze_recoveries en el summary).
FREEZE_CYCLES=25
FREEZE_RECOVERY=abort
FREEZE_MAX_RECOVERIES=2
FREEZE_BACKOFF_CYCLES=30

# ─── TECHO / ALTURA BAJA (2026-0929, ver CHANGELOG (l)) ──────────────────────
# Margen (m) bajo el techo detectado: objetivo de altitud = ceiling_z + CEILING_MARGIN_M (0.8 -> ~5.0 m con techo a 5.8 m).
CEILING_MARGIN_M=0.8
# "Vertical puro" (vx=0) solo si |dz| > NEAR_VERTICAL_RATIO * distancia_horizontal (cono); antes bastaba |dz| > 0.3 m.
NEAR_VERTICAL_RATIO=1.0


# ─── ATERRIZAJE ──────────────────────────────────────────────────────────────
# Velocidad de descenso (m/s) en el aterrizaje suave al finalizar la misión.
# land_smooth() baja de altura de crucero (~10 m) a z=-0.3 m antes de cortar
# motores. Con 0.5 m/s el descenso tarda ~20 s; con 1.0 m/s ~10 s.
LAND_DESCENT_SPEED_MPS=0.5

# --- Auditoria DistMin (src/logging/distmin_audit.py, 2026-0930) ---
# Hilo aislado con su propia conexion RPC: muestrea DepthPlanar de la camara frontal (p5 del tercio
# central) cada DISTMIN_TRACK_PERIOD_S y escribe <stem>.distmin.ndjson; finalize_run lo consolida en el
# summary.json. Nada vuelve al grafo (tests/test_no_depth_in_flight_path.py).
DISTMIN_TRACK_ENABLED=true
DISTMIN_TRACK_PERIOD_S=1.0

# --- Despegue vertical (WaypointTracker, 2026-0930) ---
# Subir en el lugar hasta TAKEOFF_ALT_TOL_M de la altitud del primer objetivo antes de avanzar
# (piloto citysim_pilot seed 99: avanzando mientras subia choco el parapeto de la autopista a 7.4 m).
TAKEOFF_VERTICAL=true
TAKEOFF_ALT_TOL_M=1.0
# Trabado de costado (avance ordenado, desplazamiento < N m por ciclo): no cuenta para detectar techo.
CEILING_SIDEWAYS_STUCK_M=0.03


# ─── PERCEPCIÓN / FLUJO ÓPTICO ───────────────────────────────────────────────
# Ancho (px) al que se reduce el frame ANTES de calcular flujo óptico
# (FlowTTCEstimator.estimate()). Independiente de VLM_IMAGE_MAX_SIZE.
# Subido 320 → 640 en 2026-0828: a 320px objetos finos (ramas) caen bajo el
# piso de ruido (FLOW_NOISE_FLOOR_PX) y el estimador devuelve confianza~0
# aunque la cámara de profundidad detecte el acercamiento real.
FLOW_DOWNSCALE_WIDTH=640
# Umbrales TTC calibrados (F1.3, 2026-0824). Experimento: 3735 registros,
# 3 escenarios (approach/canyon/yaw_only). AUC=0.96-0.97. Umbral Youden:
# tau=2s → TTC_est=3.18s, tau=3s → TTC_est=4.58s.
TTC_SAFE_THRESHOLD=4.6
TTC_EVASION_THRESHOLD=3.2
# Altitud mínima (m) para habilitar el SLM por obstáculos TTC/occupancy.
# Por debajo de este valor el router desvía a "evasive" sin invocar el VLM.
# Elimina los timeouts del SLM durante el ascenso inicial (WP_0 climb-first).
SLM_MIN_ALT_M=8.0
# Umbral de ocupancia calibrado (D2, 2026-0910). Dataset: 196 frames,
# TownSim, 4 velocidades (0.5-3 m/s), etiqueta de referencia = gt_depth_centro < 5 m.
# AUC=0.87. Threshold Youden: t=0.011 → TPR=0.931, FPR=0.222.
# El valor por defecto en obstacle_field.py (0.35) nunca era superado:
# max(occ_centro)=0.082 → TPR=0.034 con threshold=0.35.
OBSTACLE_OCCUPANCY_BLOCKED=0.011
# 2026-0930: el lazo de vuelo (main.py y experiments/runner.py) NO lee el sensor de profundidad
# del simulador en ningun caso: se eliminaron el aborto por proximidad (DEPTH_EMERGENCY_*), el
# freno de proximidad (DEPTH_BRAKE_DIST_M/HOLD_CYCLES/SPEED_MPS) y la metrica min_obstacle_dist_m.
# Guardia: tests/test_no_depth_in_flight_path.py.



# ─── EVASIÓN / ESCAPE ────────────────────────────────────────────────────────
EVASION_UP_SPEED=1.5
# Máximo de escapes consecutivos antes de que el árbitro fuerce un deadlock.
MAX_CONSECUTIVE_ESCAPES=2
# Altitud tope (m) del escape por ganancia de altura. Arriba de este valor
# el dron asume campo libre y reanuda la misión sin más escapes de altitud.
MAX_ESCAPE_ALT_M=30.0


# ─── MISIÓN / PLANIFICADOR (airsim-plan) ─────────────────────────────────────
# Altitud de despegue por defecto (m, NED: negativo = arriba).
DEFAULT_TAKEOFF_ALT=-10.0
DEFAULT_SPEED=5.0
# Tokens máximos en la respuesta del planificador LLM.
PLANNER_MAX_TOKENS=4000
PLANNER_TEMPERATURE=0.2
# Directorio donde quedan los manifiestos .json compilados. Si es relativo,
# se ancla a airsim-plan/ (no al CWD). WebDCS lee de MISSION_DIR/flightplans/.
MISSION_DIR="missions"
# Clases de objetos que el planificador ignora al evaluar peligro (ROE).
DEFAULT_IGNORE_CLASSES="person,car"
YOLO_WEIGHTS="weights/yolo26n-sem.pt"


# ─── VARIABLES LEGACY / DOCUMENTADAS / SIN USO ACTIVO ───────────────────────
# Estas variables están documentadas aquí para referencia histórica.
# El código NO las lee actualmente (confirmado por grep de os.getenv).
# Se mantienen comentadas para no contaminar el entorno con valores
# que podrían confundir a futuras búsquedas de "¿de dónde viene este valor?".

# AIRSIM_MODE=Drone
# Modo del vehículo (usado por airsim-poc legacy, nunca leído por airsim-loop).

# GRAPH_TIMEOUT_S=30.0
# Watchdog de un ciclo completo del grafo LangGraph. Implementado en
# la arquitectura original pero el os.getenv() fue removido en la
# refactorización F0.3. Si se reimplementa, des-comentar.

# SAFE_ALT_FOR_OVERRIDE=20.0
# Altitud a partir de la cual el override de seguridad TTC se desactiva.
# Lógica removida del gatekeeper en 2026-0824.

# SAFE_MARGIN_METERS=1.0
# Margen de seguridad pre-evasión. Reemplazado por la lógica de TTC.

# PROXIMITY_THRESHOLD_METERS=5.0
# Umbral del gatekeeper de primera generación (pre-FlowTTC). Aún leído
# por airsim-poc/reset_drone.py y check_slm.py, irrelevante para airsim-loop.

# CAMERA_FOV_DIAGONAL=90.0
# ROI_DIAGONAL=62.0
# Infraestructura de la versión YOLO/SIFT del pipeline (pre-FlowTTC, 2026-0828).
# Nunca portada al FlowTTCEstimator; se dejó documentada por si se retoma.

# EVASION_FORWARD_SPEED=0.5
# Velocidad en eje X durante la maniobra evasiva. Reemplazado por la lógica
# de DELIB_WAIT_CREEP_SPEED_MPS (src/agents/deliberative.py).

# EVASION_LATERAL_SPEED=1.2
# Velocidad lateral durante la maniobra evasiva. Reemplazado por
# EVASION_LATERAL_YAW_RATE (src/agents/action_map.py).

# REACTIVITY_FORWARD_SPEED=3.0
# Typo histórico: el código lee REACTIVE_FORWARD_SPEED (sin "ITY").
# Nunca tuvo efecto. Mantenido sólo para que git blame muestre el origen.

# ---------------------------------------------------------------------------
# V3b / V3c / V4 — señales de obstáculo invisible (2026-09-11)
# ---------------------------------------------------------------------------
# V3b: pared invisible (blind_wall_event). Defaults calibrados con corridas reales.
CMD_BLIND_FWD_MIN_MPS=0.45
CMD_BLIND_ACT_MAX_MPS=0.30
CMD_BLIND_BF_MAX=0.25
CMD_BLIND_CYCLES=2
# Fix S: vel=0 prolongado sin maniobra activa escala a deliberative directamente,
# incluso cuando stuck_invisible aun no alcanzo su umbral. Captura la fase final
# de arrastre lateral (RETROCEDER no mueve el drone, vel=0 acumula en stopped_cycles).
# 10 ciclos = 2 s a 5 Hz.
STOPPED_DELIBERATIVE_CYCLES=10
# Fix R: falta de progreso neto al WP (anti false-progress / arrastre lateral).
# Si dist_to_wp no mejoro WP_NO_PROGRESS_MIN_M metros en WP_NO_PROGRESS_THRESHOLD
# ciclos consecutivos -> escalar a deliberative (equivalente a TRAJ_STALL pero
# inmune al heading del drone y al contador bearing-exempt del WaypointTracker).
# 2 m de mejora minima en 50 ciclos (10 s a 5 Hz).
WP_NO_PROGRESS_MIN_M=2.0
WP_NO_PROGRESS_THRESHOLD=50
# V3d-scan: timeout de rotacion del barrido panoramico deep_vlm.
# Si el drone no puede rotar (malla de arbol) en N ciclos -> escape sincronico.
SCAN_ROT_TIMEOUT_CYCLES=10
# 2026-0930: vuelve a 4 rumbos (frente, derecha, atras, izquierda). Con 2 (frente/atras) el VLM no
# tenia alternativas laterales que describir y el barrido no podia proponer un rodeo.
SCAN_HEADING_COUNT_DEEP=4
# Salida de deadlock (2026-10-01): se descartan los transitables a <45 deg del rumbo que fallo o de un
# rumbo ya probado en un deadlock a <10 m (mismo WP); con historia se explora el mas distinto.
SCAN_FAILED_SECTOR_DEG=45.0
SCAN_REPEAT_RADIUS_M=10.0
SCAN_HISTORY_MAX=12
# Plan de ruta con el VLM sobre el mapa cenital, antes del vuelo (2026-10-02; src/planning/route_planner.py).
# vlm = runner/batch_runner planifican una vez por escenario y todas las corridas vuelan el mismo plan; off = manifiesto tal cual.
# 2026-10-02 (k): vlm con juicio por parches. Usa SOLO el mapa cenital (sin escaneo ni sensores del dron): cada
# candidata se muestrea cada ROUTE_PATCH_STEP_M, el VLM clasifica cada parche (street/building/trees/parking/
# elevated road) y gana la de mayor P(calle) media (a menos de ROUTE_TIE_EPS, la mas corta).
ROUTE_PLAN_MODE=vlm
# patches = clasificacion de parches (unica forma con senal, map_probe.py); image = si/no por la ruta entera.
ROUTE_JUDGE=patches
ROUTE_PATCH_STEP_M=8.0
ROUTE_PATCH_M=16.0
ROUTE_PATCH_CONTEXT_M=48.0
ROUTE_PATCH_PX=336
# Modelo del planificador (mismo servidor LOCAL_LLM_URL); si falta, usa LOCAL_LLM_MODEL_NAME. Necesita JSON
# forzado y logprobs en la misma consulta (Qwen y LFM GGUF los dan; LFM MLX no).
ROUTE_LLM_MODEL_NAME="lfm2.5-vl-1.6b:q4km-ctx8k"
# Desvios paralelos (m) que se proponen a cada lado de la recta, ademas de la recta y las dos L.
ROUTE_DETOURS_M=25,50
ROUTE_MIN_SIDE_M=10.0
ROUTE_MARGIN_M=25.0
ROUTE_IMAGE_PX=672
ROUTE_TIE_EPS=0.05
# Dibujo de cada candidata: corridor = pasillo de ROUTE_CORRIDOR_M m, recorte propio rotado (inicio abajo,
# destino arriba), resto oscurecido; line = linea roja sobre el recorte comun del tramo (version anterior).
ROUTE_RENDER=corridor
ROUTE_CORRIDOR_M=10.0

# --- Capa estrategica del VLM anclada a pose (src/agents/vlm_strategic.py) ---
# 2026-1001: el VLM mira el frame frontal dividido en una grilla de 3x3 (tercios de la imagen:
# columnas A-C, filas 1-3) y dice que sectores son volables. Cada sector tiene rumbo y elevacion
# fijados con la pose DEL FRAME; la respuesta se convierte en una sub-meta en coordenadas del mundo,
# valida aunque el dron haya girado mientras el modelo pensaba (~3-5 s).
VLM_STRATEGIC_ENABLED=true
VLM_STRATEGIC_PERIOD_S=3.0
VLM_STRATEGIC_MAX_AGE_S=10.0
# Distancia maxima de la sub-meta (nunca mas lejos que el WP real).
VLM_SUBGOAL_DIST_M=15.0
VLM_SUBGOAL_MIN_AHEAD_M=4.0
# Cambio maximo de altitud de una sub-meta (filas 1/3) y altitud minima de una sub-meta.
VLM_MAX_DZ_M=4.0
VLM_SUBGOAL_MIN_ALT_M=6.0
# Sectores libres a menos de este margen (deg) del mas cercano a la meta empatan y decide la fila
# (medio > arriba > abajo). 2026-10-07: con empate exacto la fila de abajo ganaba por 0.5 deg y el dron
# se apoyaba en la autopista elevada.
VLM_SUBGOAL_TIE_DEG=10.0
# A menos de esta distancia horizontal del WP real no se consulta ni se barre.
VLM_NEAR_WP_M=8.0
VLM_STRATEGIC_MAX_GOAL_OFF_DEG=40.0
# Con este numero de ciclos sin acercarse al objetivo se consulta aunque la meta este fuera de cuadro.
VLM_STUCK_QUERY_CYCLES=15
# Tope de tokens por modo (con json_schema la respuesta termina al cerrar el esquema; el tope solo
# corta una generacion desbocada). Con 160 el barrido se cortaba antes de la llave final.
VLM_MAX_TOKENS_STRATEGIC=384
VLM_MAX_TOKENS_DEEP=512
CAMERA_HFOV_DEG=90.0
# V4c: altitud mínima AGL para confiar en flujo óptico y escapar de deadlock.
# Por debajo de este valor el suelo genera TTC falsos y progress_stall_cycles
# acumula atasco ficticio durante el ascenso inicial. (default=4.5)
OPTICAL_MIN_ALT_M=4.5
