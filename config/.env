# ===================================================================
# dronelm — configuración unificada del proyecto (fuente única)
# ===================================================================
# Este es EL ÚNICO archivo de configuración de todo el repositorio.
# Todos los subproyectos lo leen con una ruta explícita:
#
#   airsim-loop/   → Path(__file__).parents[1|2|3] / "config" / ".env"
#   airsim-plan/   → Path(__file__).parents[3]     / "config" / ".env"
#   airsim-poc/    → Path(__file__).parents[1]     / "config" / ".env"
#   airsim-mcp/    → Path(__file__).parents[1]     / "config" / ".env"
#   airsim-kc/     → Path(__file__).parents[1]     / "config" / ".env"
#   airsim-cmd/    → Path(__file__).parents[1]     / "config" / ".env"
#   callibration_flight/ → Path(__file__).parents[1] / "config" / ".env"
#   local-llm-eval/      → Path(__file__).parents[1] / "config" / ".env"
#
# Para agregar un nuevo subproyecto: añadir load_dotenv con la
# profundidad correcta (N = niveles hasta la raíz del repo).
# ===================================================================


# ─── HARDWARE: AirSim ───────────────────────────────────────────────────────
# IP de la máquina que corre Unreal Engine / AirSim.
# 2026-0824: migrado a loopback. airsim-loop corre EN la misma máquina que
# UE/AirSim (Windows); la latencia RPC sobre LAN era >8s independiente de la
# resolución (timeout sistemático en simGetImages sobre 192.168.110.110).
# Mover de vuelta a red: cambiar a 192.168.110.110 y remedir con
# scripts/bench_capture.py antes de confiar en LOOP_HZ=5.
AIRSIM_IP="127.0.0.1"
# AIRSIM_HOST es el alias que usa airsim-plan/config.py — mismo valor.
AIRSIM_HOST="127.0.0.1"
AIRSIM_PORT=41451
AIRSIM_VEHICLE_NAME="SimpleFlight"
AIRSIM_CAMERA_NAME="0"
DEFAULT_FRAME_WIDTH=1080
DEFAULT_FRAME_HEIGHT=720
# Timeout (s) por llamada RPC individual. Con AirSim en localhost <100ms
# en régimen; si sigue timeando en 127.0.0.1 es GPU saturada, no red.
AIRSIM_RPC_TIMEOUT=8
# false solo en tests: permite frames sintéticos si AirSim no responde.
AIRSIM_STRICT=true


# ─── SERVIDOR LLM (LM Studio) ────────────────────────────────────────────────
# Mac en 192.168.110.101, puerto 1234. La latencia de red está absorbida por
# diseño: DeliberationService llama al VLM en hilo separado → el brazo `slm`
# nunca bloquea el loop de control (ver src/agents/deliberation_service.py).
#
# LOCAL_LLM_* : usado por airsim-loop (deliberative.py, deep_scan.py, spatial_scan.py)
LOCAL_LLM_URL="http://192.168.110.101:1234/v1"
LOCAL_LLM_API_KEY="OLLAMA_MOCK_KEY"
LOCAL_LLM_MODEL_NAME="qwen/qwen2.5-vl-3b"
#
# OLLAMA_* / TACTICAL_* : aliases usados por airsim-plan/config.py.
# Apuntan al mismo servidor; separados para poder usar modelos distintos
# en el planificador de misión (táctico) vs. el árbitro de evasión (VLM).
OLLAMA_BASE_URL="http://192.168.110.101:1234/v1"
OLLAMA_API_KEY="OLLAMA_MOCK_KEY"
OLLAMA_MODEL="qwen/qwen2.5-vl-3b"
TACTICAL_BASE_URL="http://192.168.110.101:1234/v1"
TACTICAL_API_KEY="OLLAMA_MOCK_KEY"
TACTICAL_MODEL="qwen/qwen2.5-vl-3b"
#
# OLLAMA_HOST : alias sin /v1, usado por local-llm-eval/check_ollama.py.
OLLAMA_HOST="http://192.168.110.101:1234"


# ─── DELIBERACIÓN / VLM ──────────────────────────────────────────────────────
# Habilitar el envío de imagen al VLM (false = modo texto puro, útil para debug).
VLM_VISION_ENABLED=true
# Ancho máximo (px) del frame enviado al VLM. Independiente de FLOW_DOWNSCALE_WIDTH
# (que sólo afecta el cálculo de flujo óptico, no lo que ve el modelo).
VLM_IMAGE_MAX_SIZE=384
# Cuántos frames consecutivos se incluyen en cada prompt de visión.
VLM_FRAME_HISTORY_SIZE=1
# Usar JSON schema en la respuesta del VLM para obtener structured output.
VLM_USE_JSON_SCHEMA=true
# Watchdog del brazo deliberativo: ms máximos esperando respuesta antes de
# caer al fallback reactivo. Calibrado 2026-0824: régimen 2-3.5s, cold-start
# ~8s → 6000ms cubre el régimen con margen holgado; un cold-start de 8s+
# seguirá cayendo a fallback (timeout=True), dato real y esperado.
SLM_WATCHDOG_MS=6000
# Estrategia de desbloqueo en atasco duro (deadlock). (PLAN-SLAM, S4)
# slam_assess: historial de trayectoria + frame frontal, sin rotación panorámica (default S4).
# deep_vlm:   escaneo panorámico 4-rumbos + consulta VLM (legado, comparación S6).
# blind:      escape por ganancia de altitud sin VLM (red de seguridad, legado).
DEADLOCK_STRATEGY=slam_assess


# ─── LAZO DE CONTROL ─────────────────────────────────────────────────────────
# Frecuencia (Hz) del loop de control. Con AirSim en localhost medir con
# airsim-loop/scripts/bench_capture.py antes de subir de 5 Hz.
LOOP_HZ=5.0
# Brazo de política activo: slm | fsm | reactive.
# Sobreescrito por runner.py y batch_runner.py durante corridas batch.
AGENT_ARM=slm


# ─── GRABACIÓN Y LOGGING ─────────────────────────────────────────────────────
# Directorio raíz donde cada corrida crea su carpeta <MISSION_ID>-<ISO>/.
# Si es relativo, se ancla a la raíz del repo (no al CWD del script).
# El directorio físico es dronelm/airsim-runs/ — todos los subproyectos
# escriben ahí. Ignorado por git (ver .gitignore).
AIRSIM_RUNS_DIR="airsim-runs"
# Grabar video anotado por corrida (src/logging/flight_video.py). Opt-in;
# poner false para corridas batch/headless donde el video no se necesita
# (ahorra ~30% de ciclos de CPU). runner.py puede sobreescribir vía env.
FLIGHT_RECORD_VIDEO=true

# Grabar el viewport de Unreal Engine lado a lado con la cámara del drone.
# Requiere: pip install mss pywin32 (solo en Windows).
# Cuando está activo el video sale con doble ancho: [drone cam | viewport UE].
# Si mss/pywin32 no están instalados, o la ventana no está visible, el panel
# derecho sale en negro y el video sigue grabándose sin error (degradación
# silenciosa). Dejar false en corridas batch o headless (sin UE en pantalla).
# Default: false
FLIGHT_RECORD_VIEWPORT=false

# Substring del título de la ventana de Unreal Engine que busca ViewportCapture.
# Se compara ignorando mayúsculas; la primera ventana visible que lo contenga
# y tenga tamaño > 100×100 px es la que se captura.
# UE5 típicamente se llama "UnrealEditor - <NombreProyecto>".
# Default: UnrealEditor
VIEWPORT_WINDOW_TITLE="UnrealEditor"

# Región fija de pantalla a capturar en lugar de buscar la ventana por título.
# Formato: left,top,right,bottom  (coordenadas absolutas de pantalla en píxeles).
# Útil si la detección automática de ventana falla o se quiere capturar solo
# el viewport interior (sin el chrome del editor).
# Ejemplo (monitor 1920×1080, viewport en la mitad derecha):
#   VIEWPORT_REGION=960,0,1920,1080
# Si está vacío, se usa VIEWPORT_WINDOW_TITLE para encontrar la ventana.
# Default: (vacío — detección automática por título)
# VIEWPORT_REGION=


# ─── NAVEGACIÓN / GUIADO ─────────────────────────────────────────────────────
# Velocidad de crucero (m/s) del brazo reactivo y referencia de guía.
# Subido 2.0 → 3.0 en 2026-0826: TTC_SAFE/EVASION son umbrales de TIEMPO,
# no de distancia; el margen de reacción no se degrada al subir la velocidad.
# No subir sin remedir en CityParkSim (obstáculos reales) antes de confiar.
REACTIVE_FORWARD_SPEED=3.0
# Topes de yaw_rate del guiado (°/s). El sharp es para desvíos >60°; permite
# realinear un desvío grande sin que el contador de atasco se dispare primero.
GUIDANCE_YAW_RATE_MAX_DPS=15.0
GUIDANCE_YAW_RATE_SHARP_MAX_DPS=45.0
# Velocidad mínima (m/s) de acercamiento a un WP para no acumular atasco.
# Con WAYPOINT_PROGRESS_EPS_M=0.5 (hardcoded) y LOOP_HZ=5 el umbral efectivo
# resulta ceil(0.5*5/0.25)=10 ciclos. Ver waypoint_tracker.py:effective_stall_threshold().
MIN_PROGRESS_SPEED_MPS=0.25
# Multiplicador del umbral de atasco: si el contador llega a
# EVASION_STUCK_THRESHOLD * STUCK_HARD_FACTOR el escape se fuerza aunque
# la percepción crea ver un corredor libre (techo del bypass por percepción).
STUCK_HARD_FACTOR=3.0
# Ciclos consecutivos sin progreso antes de disparar escape por altura.
# Derivado de MIN_PROGRESS_SPEED_MPS arriba; puede sobreescribirse aquí si
# se quiere un umbral fijo independiente de la fórmula dinámica.
EVASION_STUCK_THRESHOLD=10


# ─── PLAN-SLAM: mitigaciones de percepción monocular (P1–P3) ─────────────────
# P2: holdover — cuántos frames se sostiene el último TTC válido cuando
# foe_confidence=0 (giro activo, textura baja). Default=3 → 0.6s a 5Hz.
FLOW_HOLDOVER_MAX_FRAMES=3
# P3: tope de yaw_rate (°/s) cuando el dron está cerca de un obstáculo
# (TTC_centro < TTC_BLOCKED_THRESHOLD_S). Mantiene derotación dentro del
# límite operativo de FlowTTCEstimator (~0.175 rad/s ≈ 10°/s).
FLOW_MAX_YAW_DPS_NEAR_OBSTACLE=5.0


# ─── PLAN-SLAM: slam_assess (S1–S3) ──────────────────────────────────────────
# S1: tamaño del ring buffer de trayectoria (ciclos). 80 ≈ 16s a 5Hz.
SLAM_HISTORY_SIZE=80
# S1: umbral de retroceso al WP (m) para clasificar un ciclo como stall.
SLAM_STALL_THRESHOLD_M=0.3
# S3: máximo de eventos a incluir en el contexto textual por prompt.
SLAM_CONTEXT_MAX_EVENTS=30
# S3: mínimo de eventos para enviar historial (en los primeros ciclos el
# buffer puede estar vacío — se notifica al VLM en su lugar).
SLAM_MIN_EVENTS_FOR_CONTEXT=5
# S3b (YOLO semántico en stalls): desactivado por defecto.
# SLAM_YOLO_ENABLED=false
# SLAM_YOLO_MODEL=yolov8n.pt
# SLAM_YOLO_MIN_CONF=0.45
# S2b (SfM por sectores): desactivado por defecto.
# SLAM_SFM_ENABLED=false


# ─── PERCEPCIÓN / FLUJO ÓPTICO ───────────────────────────────────────────────
# Ancho (px) al que se reduce el frame ANTES de calcular flujo óptico
# (FlowTTCEstimator.estimate()). Independiente de VLM_IMAGE_MAX_SIZE.
# Subido 320 → 640 en 2026-0828: a 320px objetos finos (ramas) caen bajo el
# piso de ruido (FLOW_NOISE_FLOOR_PX) y el estimador devuelve confianza~0
# aunque la cámara de profundidad detecte el acercamiento real.
FLOW_DOWNSCALE_WIDTH=640
# Umbrales TTC calibrados (F1.3, 2026-0824). Experimento: 3735 registros,
# 3 escenarios (approach/canyon/yaw_only). AUC=0.96-0.97. Umbral Youden:
# tau=2s → TTC_est=3.18s, tau=3s → TTC_est=4.58s.
TTC_SAFE_THRESHOLD=4.6
TTC_EVASION_THRESHOLD=3.2
# Altitud mínima (m) para habilitar el SLM por obstáculos TTC/occupancy.
# Por debajo de este valor el router desvía a "evasive" sin invocar el VLM.
# Elimina los timeouts del SLM durante el ascenso inicial (WP_0 climb-first).
SLM_MIN_ALT_M=8.0
# Umbral de ocupancia calibrado (D2, 2026-0910). Dataset: 196 frames,
# TownSim, 4 velocidades (0.5-3 m/s), GT = gt_depth_centro < 5 m.
# AUC=0.87. Threshold Youden: t=0.011 → TPR=0.931, FPR=0.222.
# El valor por defecto en obstacle_field.py (0.35) nunca era superado:
# max(occ_centro)=0.082 → TPR=0.034 con threshold=0.35.
OBSTACLE_OCCUPANCY_BLOCKED=0.011


# ─── EVASIÓN / ESCAPE ────────────────────────────────────────────────────────
EVASION_UP_SPEED=1.5
# Máximo de escapes consecutivos antes de que el árbitro fuerce un deadlock.
MAX_CONSECUTIVE_ESCAPES=2
# Altitud tope (m) del escape por ganancia de altura. Arriba de este valor
# el dron asume campo libre y reanuda la misión sin más escapes de altitud.
MAX_ESCAPE_ALT_M=30.0


# ─── MISIÓN / PLANIFICADOR (airsim-plan) ─────────────────────────────────────
# Altitud de despegue por defecto (m, NED: negativo = arriba).
DEFAULT_TAKEOFF_ALT=-10.0
DEFAULT_SPEED=5.0
# Tokens máximos en la respuesta del planificador LLM.
PLANNER_MAX_TOKENS=4000
PLANNER_TEMPERATURE=0.2
# Directorio donde quedan los manifiestos .json compilados. Si es relativo,
# se ancla a airsim-plan/ (no al CWD). WebDCS lee de MISSION_DIR/flightplans/.
MISSION_DIR="missions"
# Clases de objetos que el planificador ignora al evaluar peligro (ROE).
DEFAULT_IGNORE_CLASSES="person,car"
YOLO_WEIGHTS="weights/yolo26n-sem.pt"


# ─── VARIABLES LEGACY / DOCUMENTADAS / SIN USO ACTIVO ───────────────────────
# Estas variables están documentadas aquí para referencia histórica.
# El código NO las lee actualmente (confirmado por grep de os.getenv).
# Se mantienen comentadas para no contaminar el entorno con valores
# que podrían confundir a futuras búsquedas de "¿de dónde viene este valor?".

# AIRSIM_MODE=Drone
# Modo del vehículo (usado por airsim-poc legacy, nunca leído por airsim-loop).

# GRAPH_TIMEOUT_S=30.0
# Watchdog de un ciclo completo del grafo LangGraph. Implementado en
# la arquitectura original pero el os.getenv() fue removido en la
# refactorización F0.3. Si se reimplementa, des-comentar.

# SAFE_ALT_FOR_OVERRIDE=20.0
# Altitud a partir de la cual el override de seguridad TTC se desactiva.
# Lógica removida del gatekeeper en 2026-0824.

# SAFE_MARGIN_METERS=1.0
# Margen de seguridad pre-evasión. Reemplazado por la lógica de TTC.

# PROXIMITY_THRESHOLD_METERS=5.0
# Umbral del gatekeeper de primera generación (pre-FlowTTC). Aún leído
# por airsim-poc/reset_drone.py y check_slm.py, irrelevante para airsim-loop.

# CAMERA_FOV_DIAGONAL=90.0
# ROI_DIAGONAL=62.0
# Infraestructura de la versión YOLO/SIFT del pipeline (pre-FlowTTC, 2026-0828).
# Nunca portada al FlowTTCEstimator; se dejó documentada por si se retoma.

# EVASION_FORWARD_SPEED=0.5
# Velocidad en eje X durante la maniobra evasiva. Reemplazado por la lógica
# de DELIB_WAIT_CREEP_SPEED_MPS (src/agents/deliberative.py).

# EVASION_LATERAL_SPEED=1.2
# Velocidad lateral durante la maniobra evasiva. Reemplazado por
# EVASION_LATERAL_YAW_RATE (src/agents/action_map.py).

# REACTIVITY_FORWARD_SPEED=3.0
# Typo histórico: el código lee REACTIVE_FORWARD_SPEED (sin "ITY").
# Nunca tuvo efecto. Mantenido sólo para que git blame muestre el origen.
