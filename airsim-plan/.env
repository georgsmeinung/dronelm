# OLLAMA (OpenAI-compatible) local server for the Mission Planner.
OLLAMA_BASE_URL="http://192.168.110.101:1234/v1"
OLLAMA_API_KEY="ollama-key"
OLLAMA_MODEL="qwen/qwen3.5-2b"

# Tactical SLM (Phi-3) served the same way. Kept separate so you can swap models.
TACTICAL_BASE_URL="http://192.168.110.101:1234/v1"
TACTICAL_API_KEY="ollama-key"
TACTICAL_MODEL="qwen/qwen3.5-2b"

# AirSim
AIRSIM_VEHICLE_NAME="SimpleFlight"
AIRSIM_HOST="192.168.110.110"
AIRSIM_PORT="41451"
AIRSIM_LOOP_WATCH=true

# Mission defaults
DEFAULT_TAKEOFF_ALT=-1.0
DEFAULT_SPEED=5.0
PLANNER_MAX_TOKENS=4000

YOLO_WEIGHTS="weights/yolo26n-sem.pt"

LOCAL_LLM_URL="http://192.168.110.101:1234/v1"
LOCAL_LLM_API_KEY="OLLAMA_MOCK_KEY"
LOCAL_LLM_MODEL_NAME="qwen/qwen2.5-vl-3b"

VLM_FRAME_HISTORY_SIZE=2