{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lm-drone.local/schemas/manifest.schema.json",
  "title": "MissionManifest",
  "type": "object",
  "required": ["mission_id", "waypoints"],
  "additionalProperties": false,
  "properties": {
    "mission_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{3,32}$",
      "description": "Uppercase identifier for the mission (e.g. PERIMETER_NORTH_01)."
    },
    "summary": {
      "type": "string",
      "description": "Human-readable one-line description."
    },
    "waypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["x", "y", "z"],
        "additionalProperties": false,
        "properties": {
          "x": {"type": "number"},
          "y": {"type": "number"},
          "z": {"type": "number"},
          "label": {"type": "string"}
        }
      }
    },
    "map": {
      "type": "string",
      "description": "The filename of the map image used for the mission."
    }
  }
}
