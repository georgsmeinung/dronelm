# OLLAMA (OpenAI-compatible) local server for the Mission Planner.
OLLAMA_BASE_URL="http://192.168.110.101:11434/v1"
OLLAMA_API_KEY="ollama-key"
OLLAMA_MODEL="qwen3.5:0.8b"

# Tactical SLM (Phi-3) served the same way. Kept separate so you can swap models.
TACTICAL_BASE_URL="http://192.168.110.101:11434/v1"
TACTICAL_API_KEY="ollama-key"
TACTICAL_MODEL="qwen3.5:0.8b"

# AirSim
AIRSIM_VEHICLE_NAME="SimpleFlight"
AIRSIM_HOST="192.168.110.110"
AIRSIM_PORT="41451"
AIRSIM_LOOP_WATCH=true

# Mission defaults
DEFAULT_TAKEOFF_ALT=-1.0
DEFAULT_SPEED=5.0
PLANNER_MAX_TOKENS=4000
