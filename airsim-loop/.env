AIRSIM_MODE=Drone
# IP address of the machine running the AirSim / Unreal Engine simulator.
# 2026-0824: cambiado a loopback. El benchmark de scripts/bench_capture.py
# contra 192.168.110.110 (Windows) desde la Mac dio timeout (8-9s, el tope de
# AIRSIM_RPC_TIMEOUT) en simGetImages para TODAS las resoluciones probadas
# (1080x720, 640x480, 320x240) por igual -- ver CHANGELOG.md 2026-0824 para
# la tabla completa. Al ser independiente de la resolución, no era un
# problema de ancho de banda sino del socket RPC sobre esa LAN. Se decidió
# correr airsim-loop en la MISMA máquina que Unreal Engine/AirSim (Windows),
# y dejar el servidor del SLM (LOCAL_LLM_URL más abajo) en la Mac por red --
# esa latencia sí está absorbida por diseño (DeliberationService asíncrono).
AIRSIM_IP="127.0.0.1"
AIRSIM_PORT = 41451
AIRSIM_VEHICLE_NAME = "SimpleFlight"
AIRSIM_CAMERA_NAME = "0"
DEFAULT_FRAME_WIDTH = "1080"
DEFAULT_FRAME_HEIGHT = "720"
# Timeout (segundos) para cada llamada RPC individual al servidor AirSim
# (simGetImages, getMultirotorState, moveByVelocityBodyFrameAsync, etc.).
# Si AirSim no responde en este tiempo, lanza excepción en lugar de colgar el hilo.
# Con AirSim en localhost esto debería sobrar de sobra (simGetImages en loopback
# suele responder en <100ms); si vuelve a haber timeouts aun en 127.0.0.1, es una
# señal real (Unreal Engine sobrecargado/GPU saturada), no de red.
AIRSIM_RPC_TIMEOUT = 8
# Frecuencia (Hz) del lazo de control. Con AirSim remoto el link de red no sostenía
# ninguna frecuencia útil (ver AIRSIM_IP arriba); con AirSim local, re-medir con
# scripts/bench_capture.py y subir este valor según el p95 real antes de volar.
LOOP_HZ = 5.0
# false solo para tests: permite frames sintéticos si AirSim no responde.
AIRSIM_STRICT = true
# Brazo de política activo: slm | fsm | reactive (ver src/agents/fsm.py, F3.1).
AGENT_ARM = slm
# Timeout (segundos) máximo por ciclo completo del grafo (captura + percepción + control).
# Si el grafo supera este tiempo (p. ej. por un deadlock RPC), el watchdog envía hover
# de emergencia y recupera el bucle sin crash.
GRAPH_TIMEOUT_S = 30.0
# Ciclos consecutivos en modo evasivo/deliberativo sin progresar antes de forzar GANAR_ALTURA.
# Valor más bajo = escape más rápido pero menos tolerante a evasiones largas legítimas.
EVASION_STUCK_THRESHOLD = 10
# Altitud (metros) por encima de la cual el OVERRIDE de seguridad se desactiva cuando TTC=inf.
# A esa altura el drone ya está visualmente sobre el obstáculo y la estimación monocular
# de distancia (basada en bbox) es incorrecta; se deja al LLM decidir libremente.
SAFE_ALT_FOR_OVERRIDE = 20.0
# Margen de seguridad (metros) antes de forzar una acción evasiva/subida
SAFE_MARGIN_METERS = 1.0

# Umbrales para el Gatekeeper
PROXIMITY_THRESHOLD_METERS = 5.0

# Paso 1: Canny XOR Gate
CANNY_XOR_THRESHOLD = 0.03
CANNY_LOW = 50
CANNY_HIGH = 150

# Paso 2: ROI 62°
CAMERA_FOV_DIAGONAL = 90.0
ROI_DIAGONAL = 62.0

# Paso 3 y 4: TTC Estimator y Bifurcación
# PROVISORIOS: pendientes de calibrar con experiments/collect_ttc_dataset.py +
# experiments/analyze_ttc.py (curva ROC contra el canal depth, F1.3). Ahora que
# AirSim corre local y el lazo puede sostener una frecuencia real, correr eso
# es el siguiente paso antes de confiar en estos números para vuelo real.
TTC_SAFE_THRESHOLD = 6.0
TTC_EVASION_THRESHOLD = 3.0
EVASION_FORWARD_SPEED = 0.5
EVASION_LATERAL_SPEED = 1.2
EVASION_UP_SPEED = 1.5

# Configuracion del Nodo Reactivo
REACTIVITY_FORWARD_SPEED = 2.0
REACTIVE_FORWARD_SPEED = 2.0

# Configuración del SLM Local (Ollama)
LOCAL_LLM_URL = "http://192.168.110.101:1234/v1"
LOCAL_LLM_API_KEY="OLLAMA_MOCK_KEY"
LOCAL_LLM_MODEL_NAME = "qwen/qwen2.5-vl-3b"

# Visión directa al VLM (deshabilitar para volver al modo texto puro)
VLM_VISION_ENABLED = true
VLM_IMAGE_MAX_SIZE = 384
VLM_FRAME_HISTORY_SIZE = 1
VLM_USE_JSON_SCHEMA = true

# (YOLO retirado del pipeline -- ver airsim-loop/legacy/README.md. Config removida.)
