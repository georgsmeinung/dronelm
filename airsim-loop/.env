AIRSIM_MODE=Drone
# IP address of the machine running the AirSim / Unreal Engine simulator.
# If the simulator is running on the same machine, use 127.0.0.1.
# If running on a different machine (e.g., Windows PC while running Python on Mac),
# use the local IP address of that machine (e.g., 192.168.1.100).
AIRSIM_IP="192.168.110.110"
AIRSIM_PORT = 41451
AIRSIM_VEHICLE_NAME = "SimpleFlight"
AIRSIM_CAMERA_NAME = "0"
DEFAULT_FRAME_WIDTH = "1080"
DEFAULT_FRAME_HEIGHT = "720"

# Umbrales para el Gatekeeper
PROXIMITY_THRESHOLD_METERS = 5.0

# Configuracion del Nodo Reactivo
REACTIVE_FORWARD_SPEED = 2.0

# Configuración del SLM Local (Ollama)
LOCAL_LLM_URL = "http://192.168.110.101:11434/v1"
LOCAL_LLM_API_KEY="OLLAMA_MOCK_KEY"
LOCAL_LLM_MODEL_NAME = "qwen3.5:0.8b"

# Configuración YOLO
YOLO_WEIGHTS = "weights/yolo26n-sem.engine"
YOLO_CONF = 0.15