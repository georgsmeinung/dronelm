AIRSIM_MODE=Drone
# IP address of the machine running the AirSim / Unreal Engine simulator.
# 2026-0824: cambiado a loopback. El benchmark de scripts/bench_capture.py
# contra 192.168.110.110 (Windows) desde la Mac dio timeout (8-9s, el tope de
# AIRSIM_RPC_TIMEOUT) en simGetImages para TODAS las resoluciones probadas
# (1080x720, 640x480, 320x240) por igual -- ver CHANGELOG.md 2026-0824 para
# la tabla completa. Al ser independiente de la resolución, no era un
# problema de ancho de banda sino del socket RPC sobre esa LAN. Se decidió
# correr airsim-loop en la MISMA máquina que Unreal Engine/AirSim (Windows),
# y dejar el servidor del SLM (LOCAL_LLM_URL más abajo) en la Mac por red --
# esa latencia sí está absorbida por diseño (DeliberationService asíncrono).
AIRSIM_IP="127.0.0.1"
AIRSIM_PORT = 41451
AIRSIM_VEHICLE_NAME = "SimpleFlight"
AIRSIM_CAMERA_NAME = "0"
DEFAULT_FRAME_WIDTH = "1080"
DEFAULT_FRAME_HEIGHT = "720"
# Timeout (segundos) para cada llamada RPC individual al servidor AirSim
# (simGetImages, getMultirotorState, moveByVelocityBodyFrameAsync, etc.).
# Si AirSim no responde en este tiempo, lanza excepción en lugar de colgar el hilo.
# Con AirSim en localhost esto debería sobrar de sobra (simGetImages en loopback
# suele responder en <100ms); si vuelve a haber timeouts aun en 127.0.0.1, es una
# señal real (Unreal Engine sobrecargado/GPU saturada), no de red.
AIRSIM_RPC_TIMEOUT = 8
# Frecuencia (Hz) del lazo de control. Con AirSim remoto el link de red no sostenía
# ninguna frecuencia útil (ver AIRSIM_IP arriba); con AirSim local, re-medir con
# scripts/bench_capture.py y subir este valor según el p95 real antes de volar.
LOOP_HZ = 5.0
# false solo para tests: permite frames sintéticos si AirSim no responde.
AIRSIM_STRICT = true
# Brazo de política activo: slm | fsm | reactive (ver src/agents/fsm.py, F3.1).
AGENT_ARM = slm
# Timeout (segundos) máximo por ciclo completo del grafo (captura + percepción + control).
# Si el grafo supera este tiempo (p. ej. por un deadlock RPC), el watchdog envía hover
# de emergencia y recupera el bucle sin crash.
GRAPH_TIMEOUT_S = 30.0
# Ciclos consecutivos en modo evasivo/deliberativo sin progresar antes de forzar GANAR_ALTURA.
# Valor más bajo = escape más rápido pero menos tolerante a evasiones largas legítimas.
EVASION_STUCK_THRESHOLD = 10
# Altitud (metros) por encima de la cual el OVERRIDE de seguridad se desactiva cuando TTC=inf.
# A esa altura el drone ya está visualmente sobre el obstáculo y la estimación monocular
# de distancia (basada en bbox) es incorrecta; se deja al LLM decidir libremente.
SAFE_ALT_FOR_OVERRIDE = 20.0
# Margen de seguridad (metros) antes de forzar una acción evasiva/subida
SAFE_MARGIN_METERS = 1.0

# Umbrales para el Gatekeeper
PROXIMITY_THRESHOLD_METERS = 5.0

# (Canny XOR Gate retirado del pipeline -- F0.4, 2026-0824. Medido en vuelo real
# (446 ciclos, LOOP_HZ=5.0): el bypass no solo casi nunca disparaba en crucero
# activo (xor_change_ratio nunca bajo de 0.071, p50=0.247, muy por encima de
# cualquier umbral razonable), sino que en el ~1% de los ciclos donde SI
# disparaba -- hover post-FRENAR, esperando deliberacion -- saltaba entero
# policy_router y resumia MANTENER_RUMBO sin re-evaluar el campo de obstaculos
# justo cuando el dron estaba parado por una razon de seguridad. Ver
# CHANGELOG.md 2026-0824 y legacy/README.md para el detalle completo.
# Config removida: CANNY_XOR_THRESHOLD, CANNY_LOW, CANNY_HIGH.)

# Paso 2: ROI 62°
CAMERA_FOV_DIAGONAL = 90.0
ROI_DIAGONAL = 62.0

# Paso 3 y 4: TTC Estimator y Bifurcación
# CALIBRADO (F1.3, 2026-0824): experiments/collect_ttc_dataset.py corrido sobre
# los 3 escenarios del plan (approach, canyon, yaw_only; 3735 registros,
# runs/ttc/*.jsonl) + experiments/analyze_ttc.py (curva ROC vs. TTC_gt del canal
# depth). AUC=0.96-0.97 para "colision dentro de tau s" en los 3 tau probados,
# pese a que la correlacion punto a punto es baja (r=-0.034, error relativo
# mediano 66%) -- el ranking de riesgo separa bien las clases aunque la
# magnitud puntual de TTC_est sea ruidosa. Umbral de Youden: tau=2s -> 3.18s,
# tau=3s -> 4.58s. Caveat: una sola sesion de vuelo en simulador, sin variacion
# de |yaw_rate| (yaw_only quedo casi todo en el bin [0,0.05) rad/s) -- valida
# la deteccion frontal, NO valida aun la derotacion en giros fuertes. Ver
# CHANGELOG.md 2026-0824 para la tabla completa.
TTC_SAFE_THRESHOLD = 4.6
TTC_EVASION_THRESHOLD = 3.2
EVASION_FORWARD_SPEED = 0.5
EVASION_LATERAL_SPEED = 1.2
EVASION_UP_SPEED = 1.5

# Configuracion del Nodo Reactivo
# Subido de 2.0 a 3.0 m/s (2026-0826, ver CHANGELOG.md): TTC_SAFE/EVASION_THRESHOLD
# son umbrales de TIEMPO (segundos), no de distancia -- el propio TTC ya se
# reduce proporcionalmente a la velocidad real de aproximacion, asi que el
# margen de reaccion frente a un obstaculo real no se degrada al subir la
# velocidad de crucero. No subir mucho mas sin remedir en el escenario urbano
# (CityParkSim, obstaculos reales) antes de confiar en el margen.
REACTIVITY_FORWARD_SPEED = 3.0
REACTIVE_FORWARD_SPEED = 3.0

# CALIBRADO (2026-0824): con LM Studio corriendo, 4 muestras reales
# (vision + json_schema, misma llamada que hace deliberative.py) dieron
# 8298/3405/2201/1911 ms -- la primera es el cold-start de carga del modelo,
# en regimen ronda 2-3.5s. El default anterior (1500ms, ni siquiera
# versionado en este archivo) garantizaba fallback en el 100% de los casos
# aunque el servidor estuviera sano. 6000ms cubre el regimen con margen; un
# cold-start de 8s+ seguiria cayendo a fallback (timeout=True), dato real.
SLM_WATCHDOG_MS = 6000

# Configuración del SLM Local (Ollama)
LOCAL_LLM_URL = "http://192.168.110.101:1234/v1"
LOCAL_LLM_API_KEY="OLLAMA_MOCK_KEY"
LOCAL_LLM_MODEL_NAME = "qwen/qwen2.5-vl-3b"

# Visión directa al VLM (deshabilitar para volver al modo texto puro)
VLM_VISION_ENABLED = true
VLM_IMAGE_MAX_SIZE = 384
VLM_FRAME_HISTORY_SIZE = 1
VLM_USE_JSON_SCHEMA = true

MAX_CONSECUTIVE_ESCAPES = 2
MAX_ESCAPE_ALT_M = 30.0
# (EVASION_STUCK_THRESHOLD = 5 retirado de aca: duplicaba la definicion de mas
# arriba y ademas era incoherente con WAYPOINT_PROGRESS_EPS_M. Ver abajo.)

# Velocidad de acercamiento (m/s) por debajo de la cual se acepta que el dron
# no progresa. Junto con WAYPOINT_PROGRESS_EPS_M (0.5m por defecto) y LOOP_HZ
# define el umbral real de atasco: effective_stall_threshold() en
# waypoint_tracker.py eleva EVASION_STUCK_THRESHOLD hasta
# ceil(eps * LOOP_HZ / MIN_PROGRESS_SPEED_MPS) = 10 ciclos con estos valores.
# Motivo: con umbral=5 ciclos a 5Hz y eps=0.5m hacia falta acercarse a 0.5 m/s
# para no acumular atasco, imposible durante un giro cerrado (~0.25 m/s
# reales) -- el escape por altura se disparaba solo a los 5 ciclos de arrancar,
# sin ningun obstaculo. Ver CHANGELOG.md 2026-0824.
MIN_PROGRESS_SPEED_MPS = 0.25
# Multiplo del umbral de atasco a partir del cual el escape se fuerza aunque
# la percepcion crea ver un corredor libre (techo del bypass por percepcion).
STUCK_HARD_FACTOR = 3.0
# Topes de yaw_rate del guiado. El de giro brusco (abs_err > 60 grados) es
# mayor para que realinear un desvio grande no tarde mas que el propio
# contador de atasco en dispararse.
GUIDANCE_YAW_RATE_MAX_DPS = 15.0
GUIDANCE_YAW_RATE_SHARP_MAX_DPS = 45.0

